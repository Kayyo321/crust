// A module shared by two binaries and a test. It compiles once per profile.
module text.words;

#include <stddef.h>

export size_t count_words(ref [char] text) {
    size_t n = 0;
    bool in_word = false;
    for (size_t i = 0; i < text.len; i++) {
        let space = text[i] == ' ' || text[i] == '\0';
        if (!space && !in_word) {
            n += 1;
        }
        in_word = !space;
    }
    return n;
}
