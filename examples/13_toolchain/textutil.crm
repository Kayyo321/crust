// A module from another package, imported as "textutil/textutil" through
// `--extern textutil=<dir>`. See build.sh.
module textutil;

#include <stddef.h>

export size_t count_char(ref [char] s, char c) {
    size_t n = 0;
    for (size_t i = 0; i < s.len; i++) {
        if (s[i] == c) {
            n += 1;
        }
    }
    return n;
}
