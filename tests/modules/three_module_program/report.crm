module report;

#include <stdio.h>

import { point, distance } from "geometry";

export void print_distance(struct point a, struct point b) {
    unsafe {
        // SAFETY: the format specifier matches the double argument.
        printf("distance %.1f\n", distance(a, b));
    }
}
